---
interface Props {
  title: string;
  date: Date;
  href: string;
  status?: 'open' | 'closed' | 'limited';
  excerpt?: string;
}

const { title, date, href, status, excerpt } = Astro.props;

const statusStyles = {
  open: 'bg-emerald-100 text-emerald-800',
  closed: 'bg-red-100 text-red-800',
  limited: 'bg-amber-100 text-amber-800',
};
---

<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-200 hover:shadow-md">
  <div class="flex flex-wrap items-center gap-2">
    {
      status && (
        <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold uppercase ${statusStyles[status]}`}>
          {status}
        </span>
      )
    }
    <time datetime={date.toISOString()} class="text-sm text-slate-500">
      {date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
    </time>
  </div>
  <h3 class="mt-2 text-lg font-semibold text-slate-900">
    <a href={href} class="hover:text-sky-700">{title}</a>
  </h3>
  {excerpt && <p class="mt-2 text-sm leading-relaxed text-slate-600 line-clamp-3">{excerpt}</p>}
  <a href={href} class="mt-3 inline-block text-sm font-medium text-sky-700 hover:text-sky-900">
    Read report →
  </a>
</article>
