---
import site from '../data/site.json';
---

<footer class="mt-auto border-t border-slate-200 bg-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-3">
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Contact</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-700">
        {site.contact.mailingAddress.name}<br />
        {site.contact.mailingAddress.line1}<br />
        {site.contact.mailingAddress.city}, {site.contact.mailingAddress.state}
        {site.contact.mailingAddress.zip}
      </p>
      <p class="mt-2">
        <a href={`mailto:${site.contact.email}`} class="text-sm font-medium text-sky-700 hover:text-sky-900">
          {site.contact.email}
        </a>
      </p>
    </div>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Quick Links</h2>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a href={site.links.membership} class="text-sky-700 hover:text-sky-900">Join / Renew Membership</a></li>
        <li><a href={site.links.trailMap} class="text-sky-700 hover:text-sky-900">NH Trail Map (slednh.com)</a></li>
        <li><a href={site.social.facebook} class="text-sky-700 hover:text-sky-900">Facebook</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Trail Towns</h2>
      <p class="mt-2 text-sm text-slate-700">{site.towns.join(' · ')}</p>
      <p class="mt-4 text-xs text-slate-500">Founded {new Date(site.founded).getFullYear()}</p>
    </div>
  </div>
  <div class="border-t border-slate-100 bg-slate-50 px-4 py-4 text-center text-xs text-slate-500 sm:px-6">
    © {new Date().getFullYear()} {site.name}. Maintained by club volunteers.
  </div>
</footer>
